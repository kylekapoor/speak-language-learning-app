# Port for the REST API and the WebSocket proxy.
PORT=3001

# "live" proxies to the real ASR host below. "mock" starts a local stand-in
# that follows the same protocol (no network or credentials needed).
ASR_MODE=live

# Upstream ASR WebSocket and the headers the proxy adds to the handshake.
# These are the interview credentials from the assessment brief.
ASR_UPSTREAM_URL=wss://api.usespeak-staging.com/public/v2/ws
ASR_ACCESS_TOKEN=DFKKEIO23DSAvsdf
ASR_CLIENT_INFO=Speak Interview Test
